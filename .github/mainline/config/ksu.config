# ksu 档叠加片段（在 base.config 之后应用）
# KernelSU / SukiSU-Ultra 新版本依赖 KPROBES + EXT4_FS；
# 老兼容提交 4a0c01e 不强制，但开着不会有害，也能满足后续换版本。
CONFIG_KPROBES=y
CONFIG_KPROBES_ON_FTRACE=y
CONFIG_EXT4_FS=y

# --- SELinux：KSU 的硬前提，也是 Android 内核本来就该开的 -------------------
# KernelSU 的 kernel_compat.h 无条件 include security/selinux/ss/policydb.h，
# 连带 sidtab.h 里的 CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS /
# CONFIG_SECURITY_SELINUX_SID2STR_CACHE_SIZE。这两个 int 只有在
# CONFIG_SECURITY_SELINUX=y 时才由 Kconfig 写进 autoconf.h。
# 主线 arm64 defconfig 默认没开 SELinux（depends on
# SECURITY_NETWORK && AUDIT && NET && INET），不补会报
# "'CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS' undeclared"。
CONFIG_AUDIT=y
CONFIG_SECURITY_NETWORK=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_SECURITY_SELINUX=y
# permissive 前提：不开这个，androidboot.selinux=permissive 和 setenforce 0 都是空操作
CONFIG_SECURITY_SELINUX_DEVELOP=y

CONFIG_KSU=y
