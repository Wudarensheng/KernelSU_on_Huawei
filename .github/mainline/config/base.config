# JKM 主线基线配置（在 arm64 defconfig 之上叠加）
# 每行只能是 CONFIG_FOO=y|m|n；字符串值在 workflow 里用 sed 处理。
# 依据：厂商 4.9.148 的 merge_kirin710_defconfig + 从发布镜像解出的 IKCONFIG。

# 产物必须能被离线校验：把 .config 编进 Image
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# 版本串要可复现，不能让 setlocalversion 追加 -NNNN-g<sha>
CONFIG_LOCALVERSION_AUTO=n

# 海思平台目录（hi6250-jkm.dts 挂在这里）
CONFIG_ARCH_HISI=y

# 串口：厂商是 arm,pl011 / ttyAMA0，主线用它做 earlycon 与 console
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# 基础用户空间可见性
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK_TIME=y

# Android 分区文件系统（/data 是 f2fs，/vendor /system 是 erofs）
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EXT4_FS=y

# 干净档显式关掉 KSU；ksu 档由 ksu.config 覆盖为 y
CONFIG_KSU=n
