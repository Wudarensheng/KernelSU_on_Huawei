# ---------------------------------------------------------------------------
# 最小改动：让 permissive 真正生效
#
# 本仓库 defconfig 与 EMUI 原厂内核都是：
#     # CONFIG_SECURITY_SELINUX_DEVELOP is not set
#
# 此时 security/selinux/hooks.c 里这段被整体编译掉：
#     #ifdef CONFIG_SECURITY_SELINUX_DEVELOP
#     int selinux_enforcing;                    /* 未初始化 => 0 => permissive */
#     static int __init enforcing_setup(char *str) {...}
#     #endif
# 而 security/selinux/selinuxfs.c 的 selinux_set_enforce() 变成 return -EINVAL。
#
# Android 10 的 init 是这么落实 androidboot.selinux=permissive 的：
#     if (kernel_enforcing != is_enforcing)
#         security_setenforce(is_enforcing);    /* 失败就 PLOG(ERROR)，SELinux 保持 enforcing */
#
# 所以不改这一项，改 boot cmdline 是空操作。
# ---------------------------------------------------------------------------
CONFIG_SECURITY_SELINUX_DEVELOP=y

# ---------------------------------------------------------------------------
# 显式关闭华为安全特性
#
# 官方开源包的 defconfig 是"全开"的（HIVIEW_SELINUX / HISI_SELINUX_PROT /
# HW_ROOT_SCAN / INTEGRITY / TEE_ANTIROOT_CLIENT ...），这些是给华为自己的
# EMUI/HarmonyOS 系统用的，换成 MIUI 之后：
#   * HW_ROOT_SCAN / TEE_ANTIROOT_CLIENT / INTEGRITY 会做完整性校验，
#     发现 system 被换掉可能触发异常行为
#   * HISI_SELINUX_PROT 把 selinux_enabled 变成 __ro_after_init
# 所以这里全部显式关掉，效果等同于原来作者维护的 _KernelSU 分支。
# 写法 CONFIG_X=n 表示 disable，workflow 会调 scripts/config --disable。
# ---------------------------------------------------------------------------
CONFIG_HIVIEW_SELINUX=n
CONFIG_HISI_SELINUX_PROT=n
CONFIG_HISI_SELINUX_EBITMAP_RO=n
CONFIG_HISI_RO_LSM_HOOKS=n
CONFIG_HUAWEI_SELINUX_DSM=n
CONFIG_HW_ROOT_SCAN=n
CONFIG_HUAWEI_PROC_CHECK_ROOT=n
CONFIG_HUAWEI_HIDESYMS=n
CONFIG_HUAWEI_EIMA=n
CONFIG_HKIP_ATKINFO=n
CONFIG_INTEGRITY=n
CONFIG_TEE_ANTIROOT_CLIENT=n
CONFIG_HW_DOUBLE_FREE_DYNAMIC_CHECK=n
CONFIG_HW_KERNEL_STP=n
CONFIG_HW_SLUB_SANITIZE=n

# GSI 移植内核不需要 root（要 root 用 gsi-ksu.config 那一档）
CONFIG_KSU=n
